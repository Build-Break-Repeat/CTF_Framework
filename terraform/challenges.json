      "points": 50,
      "image": "nginx:alpine",
      "memory": 128,
      "command": [
        "/bin/sh",
        "-c",
        "cat <<'EOF' > /usr/share/nginx/html/index.html\n<!doctype html>\n<html lang='en'>\n<head><meta charset='utf-8'><title>Source Hunt</title></head>\n<body>\n  <h1>Source Hunt</h1>\n  <p>This is a simple learning challenge.</p>\n  <p>Start by reading the page source. If that does not help, check the usual web files.</p>\n  <!-- Hint: robots.txt knows where to look next. -->\n</body>\n</html>\nEOF\ncat <<'EOF' > /usr/share/nginx/html/robots.txt\nUser-agent: *\nDisallow: /flag.txt\nEOF\nnginx -g 'daemon off;'"
      ],
      "flag": {
        "type": "file",
        "path": "/usr/share/nginx/html/flag.txt",
        "permissions": "0644",
        "owner": "root"
      },
